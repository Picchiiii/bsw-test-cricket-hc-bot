# discord
BOT_TOKEN = "your-discord-bot-token-here"

# turso (leave empty to use a local SQLite file instead)
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# optional: force a backend ("turso" or "sqlite") and the SQLite file path
# DB_BACKEND="sqlite"
# SQLITE_PATH="bsw.sqlite3"

# optional: Discord webhook that receives error reports
ERROR_WEBHOOK_URL=""

# optional: public URL of the website (overrides website_url in config.toml)
# WEBSITE_URL="https://your-site.vercel.app"

# optional: extra bot owners (comma-separated Discord user IDs). Owners control the server whitelist
# and the economy. Empty = the owner of the Discord application.
# OWNER_IDS="123456789012345678"
